# Browser-safe Strava application identifier.
VITE_STRAVA_CLIENT_ID=

# Server-only values. Never add a VITE_ prefix.
GEMINI_API_KEY=
STRAVA_CLIENT_SECRET=
OWNER_PASSWORD_HASH=
SESSION_SECRET=

# Optional: public kudos counter (Upstash Redis via the Vercel Marketplace).
# When absent, /api/kudos returns 503 and the button stays hidden.
KV_REST_API_URL=
KV_REST_API_TOKEN=
